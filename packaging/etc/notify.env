# Email alert settings for the browserrenderer gateway (alert_send tool).
# Owned root:brgateway, mode 0640 (enforced on every package configure). Only the
# gateway service loads this file; the browser backend user cannot read it, so
# credentials stay out of reach of browser_run_code_unsafe.
# After editing:  systemctl restart browserrenderer-gateway
#
# Leave SMTP_HOST empty to disable alerts (the rest of the gateway keeps working;
# alert_send then returns a "not configured" error).
#
# Works with any SMTP relay, e.g. smtp2go: SMTP_HOST=mail.smtp2go.com with
# SMTP_PORT=587 (or 2525) and SMTP_SECURITY=starttls, or SMTP_PORT=465 with
# SMTP_SECURITY=tls. Use the relay's SMTP username/password here.
SMTP_HOST=
SMTP_PORT=587

# starttls (default, STARTTLS required) | tls (implicit TLS, usually port 465) |
# none (plaintext; refused unless SMTP_HOST is localhost).
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=

# Envelope/header sender, must be accepted by the relay.
MAIL_FROM=

# The ONLY recipient. The alert_send tool has no "to" field.
MAIL_TO=

# Links in alerts must start with one of these (semicolon-separated).
ALERT_LINK_PREFIXES=https://www.finn.no/

# Maximum alert emails per rolling 24 hours.
ALERT_MAX_PER_DAY=20
