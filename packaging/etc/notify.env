# Email alert settings for the browserrenderer gateway (alert_send tool).
#
# HOW TO FILL THIS IN
#   1. Each setting below has an "Example:" line. Copy the value after "Example:"
#      to the empty setting under it and replace it with your own value.
#      The example lines are comments and are ignored.
#   2. Write values plainly: no quotes, no spaces around "=".
#   3. Save, then run:  systemctl restart browserrenderer-gateway
#   4. Check it took:   journalctl -u browserrenderer-gateway -n 5
#      ("alerts disabled: SMTP is not configured" means something is still empty)
#
# Owned root:brgateway, mode 0640 (re-applied on every package upgrade). Only the
# gateway service loads this file; the browser backend user cannot read it, so
# credentials stay out of reach of browser_run_code_unsafe.
# Leave SMTP_HOST empty to keep alerts off; the rest of the gateway still works.

# --- SMTP server -------------------------------------------------------------

# Hostname of your SMTP relay.
# Example: SMTP_HOST=mail.smtp2go.com
SMTP_HOST=

# Port on the relay. 587 or 2525 go with starttls, 465 goes with tls.
# Example: SMTP_PORT=587
SMTP_PORT=587

# starttls (plain connection upgraded to TLS, STARTTLS required; ports 587/2525)
# tls      (TLS from the first byte; usually port 465)
# none     (no encryption; refused unless SMTP_HOST is localhost)
# Example: SMTP_SECURITY=starttls
SMTP_SECURITY=starttls

# SMTP login. For smtp2go this is an SMTP user you create under
# Sending > SMTP Users, not your smtp2go account login.
# Example: SMTP_USER=browserrenderer-alerts
SMTP_USER=

# Password of that SMTP user. Paste it as-is, no quotes.
# Example: SMTP_PASS=Xk7pQ2vR9mW4tL8s
SMTP_PASS=

# --- Addresses -----------------------------------------------------------------

# Sender address. Must be on a domain or address you have verified with the
# relay (smtp2go: Sending > Verified Senders), or it will be rejected.
# Example: MAIL_FROM=alerts@example.com
MAIL_FROM=

# The ONLY recipient. The alert_send tool has no "to" field, so alerts can
# never go anywhere else.
# Example: MAIL_TO=you@example.com
MAIL_TO=

# --- Alert rules ---------------------------------------------------------------

# Links in alerts must start with one of these (semicolon-separated). Anything
# else is rejected, so a malicious listing can't get a phishing link mailed to you.
# Example: ALERT_LINK_PREFIXES=https://www.finn.no/;https://www.tise.com/
ALERT_LINK_PREFIXES=https://www.finn.no/

# Maximum alert emails per rolling 24 hours (one email can hold up to 20 deals).
# Example: ALERT_MAX_PER_DAY=20
ALERT_MAX_PER_DAY=20
