# Email alert settings for the browserrenderer gateway (alert_send tool).
#
# HOW TO FILL THIS IN
#   1. Each setting below says what it does, which values are accepted, and has
#      an "Example:" line. Put your own value after the "=" of the setting under
#      it. The comment lines (starting with #) are ignored.
#   2. Write values plainly: no spaces around "=". Quotes are optional.
#   3. Save, then run:  systemctl restart browserrenderer-gateway
#   4. Check it took:   journalctl -u browserrenderer-gateway -n 5
#      - "alerts disabled: SMTP is not configured": SMTP_HOST, MAIL_FROM or
#        MAIL_TO is still empty. Browsing still works, alerts are off.
#      - The service exits with "must be ..." (status 78): a value marked
#        [STARTUP CHECK] below is invalid. The whole connector is down until
#        it's fixed, so check the journal after every edit.
#
# Owned root:brgateway, mode 0640 (re-applied on every package upgrade). Only the
# gateway service loads this file; the browser backend user cannot read it, so
# credentials stay out of reach of browser_run_code_unsafe.
# Leave SMTP_HOST empty to keep alerts off; the rest of the gateway still works.

# --- SMTP server ---------------------------------------------------------------

# Hostname or IP address of your SMTP relay.
# Accepted: any hostname or IP. Empty = alerts off.
# Example: SMTP_HOST=mail.smtp2go.com
SMTP_HOST=

# Port on the relay.
# Accepted: [STARTUP CHECK] whole number 1-65535. Empty = 587.
#   Usual pairs: 587 or 2525 with starttls, 465 with tls, 25 with none (localhost only).
# Example: SMTP_PORT=587
SMTP_PORT=587

# How the connection is encrypted.
# Accepted: [STARTUP CHECK] exactly one of (lower or upper case). Empty = starttls.
#   starttls  plain connection upgraded to TLS; the upgrade is REQUIRED, the mail
#             is never sent unencrypted. Ports 587/2525.
#   tls       TLS from the first byte. Usually port 465.
#   none      no encryption. Only allowed when SMTP_HOST is localhost, 127.0.0.1
#             or ::1; otherwise alert_send refuses to send.
#   With starttls/tls the server certificate must be valid and TLS 1.2 or newer.
# Example: SMTP_SECURITY=starttls
SMTP_SECURITY=starttls

# SMTP login name. For smtp2go this is an SMTP user you create under
# Sending > SMTP Users, not your smtp2go account login.
# Accepted: any text. Empty = send without logging in (only works with relays
#   that allow that, e.g. a local mail server).
# Example: SMTP_USER=browserrenderer-alerts
SMTP_USER=

# Password of that SMTP user. Used only when SMTP_USER is set.
# Accepted: any text. If it contains spaces, quotes or backslashes, wrap it in
#   single quotes: SMTP_PASS='pa ss\word'. (A password containing a single quote
#   can't be written here; generate one without.)
# Example: SMTP_PASS=Xk7pQ2vR9mW4tL8s
SMTP_PASS=

# --- Addresses -----------------------------------------------------------------

# Sender address. Must be an address or domain you have verified with the relay
# (smtp2go: Sending > Verified Senders), or the relay rejects the mail.
# Accepted: one email address, optionally with a display name.
#   Empty = alerts off.
# Example: MAIL_FROM=Finn alerts <alerts@example.com>
MAIL_FROM=

# Who receives alerts. The alert_send tool has no "to" field, so alerts can
# never go anywhere else.
# Accepted: one email address, or several separated by commas.
#   Empty = alerts off.
# Example: MAIL_TO=you@example.com
MAIL_TO=

# --- Alert rules ---------------------------------------------------------------

# Links in alerts must start with one of these. Anything else is rejected, so a
# malicious listing can't get a phishing link mailed to you.
# Accepted: [STARTUP CHECK] one or more full http:// or https:// URLs separated
#   by semicolons. Empty = https://www.finn.no/
#   A bare domain gets a "/" added, so https://www.finn.no.evil.com never matches.
# Example: ALERT_LINK_PREFIXES=https://www.finn.no/;https://www.tise.com/
ALERT_LINK_PREFIXES=https://www.finn.no/

# Maximum alert emails per rolling 24 hours. One email can hold up to 20 deals,
# and the same listing is never emailed twice.
# Accepted: [STARTUP CHECK] whole number 1 or higher. Empty = 20.
# Example: ALERT_MAX_PER_DAY=20
ALERT_MAX_PER_DAY=20
