# Configuration for browserrenderer-mcp: the gateway (public endpoint) and the
# stock @playwright/mcp backend (loopback only). Email settings: notify.env.
# After editing:  systemctl restart browserrenderer-mcp   (restarts the gateway too)
# Address the GATEWAY listens on. Default 127.0.0.1 (tunnel connector on this host).
# Set 0.0.0.0 only when a connector on another host must reach it, and then
# firewall the port so that host is the only one allowed in. IPv4 literal only.
BRMCP_BIND=127.0.0.1

# TCP port the gateway listens on. Streamable HTTP endpoint is /mcp.
BRMCP_PORT=8931

# Loopback-only port of the stock playwright-mcp backend (127.0.0.1 always).
BRMCP_UPSTREAM_PORT=8932

# Idle MCP sessions are closed after this many ms (frees their browser context).
BRMCP_SESSION_IDLE_MS=3600000

# REQUIRED. Public hostname clients use to reach the service (the Host header
# seen by the server, e.g. the hostname of your Cloudflare tunnel route).
# Enforced by the gateway (403 otherwise). Both services refuse to start while empty.
# Matched EXACTLY (case-insensitive) against the HTTP Host header, so include
# ":port" if the client sends one (a tunnel normally sends just the hostname).
# Comma-separated list allowed, no spaces. Wildcards are refused.
BRMCP_HOSTNAME=

# Browser profile mode: "isolated" (in-memory, nothing kept between sessions)
# or "persistent" (kept in /var/lib/browserrenderer-mcp/profile; cookies and
# logins survive restarts).
BRMCP_PROFILE_MODE=isolated

# Browser executable. Default is Debian's chromium. To use Playwright's bundled
# Chromium instead, run /opt/browserrenderer-mcp/bin/install-bundled-chromium
# and set the path it prints. Leave empty to let Playwright find its own.
BRMCP_EXECUTABLE_PATH=/usr/bin/chromium

# 0 (default) passes --sandbox: Playwright turns the Chromium sandbox OFF
# unless asked, so this is what keeps it on. Set 1 (--no-sandbox) only if
# Chromium cannot start sandboxed (no user namespaces in the container).
BRMCP_NO_SANDBOX=0

# Viewport size as WIDTHxHEIGHT (a comma, 1440,900, is also accepted).
BRMCP_VIEWPORT=1440x900

# Navigation timeout in ms. A navigation that hasn't finished loading by then
# returns an error, but the page stays open and usable (snapshot still works).
# Keep it well under the MCP client's per-call limit (claude.ai: ~60 s), so a
# hung page fails cleanly instead of timing out the whole tool call.
BRMCP_NAV_TIMEOUT=30000

# Extra flags appended verbatim (word-split), e.g. "--caps=pdf --block-service-workers".
BRMCP_EXTRA_ARGS=
