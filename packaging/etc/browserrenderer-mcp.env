# Configuration for browserrenderer-mcp (stock @playwright/mcp).
# After editing:  systemctl restart browserrenderer-mcp
# The service binds to 127.0.0.1 only; this is not configurable.

# TCP port to listen on (loopback). Streamable HTTP endpoint is /mcp.
BRMCP_PORT=8931

# REQUIRED. Public hostname clients use to reach the service (the Host header
# seen by the server, e.g. the hostname of your Cloudflare tunnel route).
# Passed to --allowed-hosts. The service refuses to start while this is empty.
# Matched EXACTLY (case-insensitive) against the HTTP Host header, so include
# ":port" if the client sends one (a tunnel normally sends just the hostname).
# Comma-separated list allowed, no spaces. Wildcards are refused.
BRMCP_HOSTNAME=

# Browser profile mode: "isolated" (in-memory, nothing kept between sessions)
# or "persistent" (kept in /var/lib/browserrenderer-mcp/profile; cookies and
# logins survive restarts).
BRMCP_PROFILE_MODE=isolated

# Browser executable. Default is Debian's chromium. To use Playwright's bundled
# Chromium instead, run /opt/browserrenderer-mcp/bin/install-bundled-chromium
# and set the path it prints. Leave empty to let Playwright find its own.
BRMCP_EXECUTABLE_PATH=/usr/bin/chromium

# Set to 1 to pass --no-sandbox (needed in unprivileged containers where the
# Chromium sandbox cannot start). Default 0 = sandbox on.
BRMCP_NO_SANDBOX=0

# Viewport size as WIDTHxHEIGHT (a comma, 1440,900, is also accepted).
BRMCP_VIEWPORT=1440x900

# Extra flags appended verbatim (word-split), e.g. "--caps=pdf --block-service-workers".
BRMCP_EXTRA_ARGS=
