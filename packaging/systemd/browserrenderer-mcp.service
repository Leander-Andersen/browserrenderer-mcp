[Unit]
Description=Browser renderer MCP server (stock @playwright/mcp)
Documentation=file:///usr/share/doc/browserrenderer-mcp/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=browserrenderer
Group=browserrenderer
EnvironmentFile=/etc/browserrenderer-mcp/browserrenderer-mcp.env
Environment=HOME=/var/lib/browserrenderer-mcp
WorkingDirectory=/var/lib/browserrenderer-mcp
ExecStart=/opt/browserrenderer-mcp/bin/start.sh
Restart=on-failure
RestartSec=5
# Config errors (exit 78) are not fixed by retrying.
RestartPreventExitStatus=78

# Hardening. Deliberately NOT set (they break Chromium): MemoryDenyWriteExecute
# (V8 JIT), SystemCallFilter, RestrictNamespaces/PrivateUsers (Chromium's
# sandbox needs user namespaces), ProtectKernelTunables/ProcSubset.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/browserrenderer-mcp
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
