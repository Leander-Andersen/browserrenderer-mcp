#!/bin/sh
set -e
case "$1" in
  purge)
    rm -rf /var/lib/browserrenderer-mcp
    if getent passwd browserrenderer >/dev/null; then
      deluser --system browserrenderer >/dev/null 2>&1 || true
    fi
    if getent group browserrenderer >/dev/null; then
      delgroup --system browserrenderer >/dev/null 2>&1 || true
    fi
    rmdir /etc/browserrenderer-mcp 2>/dev/null || true
    if [ -d /run/systemd/system ]; then systemctl daemon-reload || true; fi
    ;;
  remove)
    if [ -d /run/systemd/system ]; then systemctl daemon-reload || true; fi
    ;;
  upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;
  *)
    echo "postrm called with unknown argument '$1'" >&2
    exit 1
    ;;
esac
exit 0
