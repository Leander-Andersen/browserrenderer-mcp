[Unit]
Description=Cloudflare tunnel for browserrenderer-mcp
After=network-online.target
Wants=network-online.target
# Token is written by the admin; nothing starts until it exists.
ConditionPathExists=/etc/cloudflared/token

[Service]
Type=notify
# --token-file keeps the token out of the process cmdline and the unit file.
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/token
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
